rules_version = '2';

// חוקי אבטחה ל-Fit or DIE!
// עקרונות:
//  1. כל פעולה דורשת התחברות (Firebase Auth).
//  2. תוכן של אתגר (משתתפים, שבועות, פיד, פאנל) נגיש רק לחברי האתגר.
//  3. הצטרפות לאתגר אפשרית רק עם קוד ההזמנה הנכון.
//  4. משקל ותמונות לפני/יעד יושבים על כרטיס המשתתף — משותפים לחברי
//     האתגר בכוונה (החלטת המשתמש, v0.2). תת-האוסף private נשמר בחוקים
//     למקרה שיתווספו בעתיד שדות פרטיים באמת.
// הערה: בתוך קבוצת חברים קטנה חלק מהעדכונים ההדדיים מותרים בכוונה
// (למשל בונוס קבוצתי שמזכה את כולם ב-XP נכתב מהמכשיר של המדווח).

service cloud.firestore {
  match /databases/{db}/documents {

    function authed() { return request.auth != null; }
    function isMember(cid) {
      return authed() &&
        exists(/databases/$(db)/documents/challenges/$(cid)/members/$(request.auth.uid));
    }

    // מיפוי משתמש → האתגר הפעיל שלו
    match /users/{uid} {
      allow read, write: if authed() && request.auth.uid == uid;
    }

    match /challenges/{cid} {
      // קריאה: כל מחובר (נדרש לאיתור אתגר לפי קוד הזמנה בעת הצטרפות)
      allow read: if authed();
      // יצירת אתגר: רק אם היוצר רושם את עצמו כמארגן
      allow create: if authed() && request.resource.data.organizerUid == request.auth.uid;
      // עדכון: חברי האתגר (עדכון captainOrder בהצטרפות נעשה ע"י המצטרף
      // שעדיין אינו חבר — לכן מותר גם עדכון שמוסיף את המשתמש עצמו לתור)
      allow update: if isMember(cid) ||
        (authed() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['captainOrder']) &&
         request.auth.uid in request.resource.data.captainOrder);

      match /members/{uid} {
        allow read: if isMember(cid) || (authed() && request.auth.uid == uid);
        // הצטרפות: רק בשם עצמך ורק עם קוד ההזמנה הנכון
        allow create: if authed() && request.auth.uid == uid &&
          request.resource.data.joinCode == get(/databases/$(db)/documents/challenges/$(cid)).data.code;
        // עדכון: חברי האתגר (כולל זיכוי XP קבוצתי הדדי)
        allow update: if isMember(cid);

        // שמור לשדות פרטיים עתידיים — אך ורק הבעלים
        match /private/{doc} {
          allow read, write: if authed() && request.auth.uid == uid;
        }
      }

      match /weeks/{w} {
        allow read, create, update: if isMember(cid);
      }

      match /feed/{id} {
        allow read, create: if isMember(cid);
        // עדכון (ריאקציות) — כל חבר; מחיקה — רק כותב הפריט
        allow update: if isMember(cid);
        allow delete: if isMember(cid) && resource.data.uid == request.auth.uid;
      }
    }
  }
}
